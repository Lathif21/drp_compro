# Netlify _headers — Security, cache & SEO optimizations for DRP BuildLab

/*
  # Security headers — boost trust & SEO ranking
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

  # SEO & crawler hints
  X-Robots-Tag: index, follow, max-image-preview:large, max-snippet:-1

# HTML — short cache so updates go live fast
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Sitemap & robots — always fresh
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

# Web app manifest — Netlify serves .webmanifest as application/octet-stream,
# which every browser rejects (and X-Content-Type-Options: nosniff above stops
# them guessing). Without this the manifest, and its icon, never load.
/site.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600

# Fonts, images, SVG — long cache (improves repeat visits / Core Web Vitals)
/*.svg
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: image/svg+xml

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

# CSS & JS (if added later) — long cache with content hashing in mind
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

# The three shared assets under /assets/ are unversioned filenames, so they
# must NOT inherit the immutable year above — a returning visitor would be
# stuck on stale CSS until 2027. One hour matches the HTML, and still caches
# them across every page navigation within a visit. Switch these to the
# immutable rule only once the filenames carry a content hash.
/assets/styles.css
  Cache-Control: public, max-age=3600
  Content-Type: text/css; charset=utf-8

/assets/app.js
  Cache-Control: public, max-age=3600
  Content-Type: text/javascript; charset=utf-8

/assets/i18n.js
  Cache-Control: public, max-age=3600
  Content-Type: text/javascript; charset=utf-8

# Images under /assets/img/ are safe to cache hard — replacing one means a
# new filename in practice.
/assets/img/*
  Cache-Control: public, max-age=604800

# Icons & social card. 7 days, not `immutable` — long enough to be cheap,
# short enough that a corrected icon reaches people who cached the old one.
/favicon.svg
  Cache-Control: public, max-age=604800
  Content-Type: image/svg+xml

/favicon.ico
  Cache-Control: public, max-age=604800
  Content-Type: image/x-icon

/*.png
  Cache-Control: public, max-age=604800
  Content-Type: image/png
