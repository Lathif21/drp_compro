{
  "name": "drp-buildlab-site",
  "private": true,
  "description": "Static site. This package.json exists only for the tools in tools/ — Netlify never runs it and the site has no build step.",
  "scripts": {
    "build": "node tools/build.js",
    "locales": "node tools/build-locales.js",
    "prerender": "node tools/prerender.js",
    "translate": "node tools/translate.js",
    "check-prices": "node tools/check-prices.js",
    "check": "node tools/check-prices.js --live-only && node tools/check-labels.js --live-only",
    "check-labels": "node tools/check-labels.js",
    "check-forms": "node tools/check-forms.js",
    "check-responsive": "node tools/check-responsive.js",
    "check-assets": "node tools/check-assets.js",
    "dev": "node tools/build.js --market=be"
  },
  "devDependencies": {
    "marked": "^15.0.12",
    "playwright-core": "^1.62.1",
    "yaml": "^2.9.1"
  }
}
