# Netlify _redirects — SEO-friendly URL handling

# Force apex (no www) — prevents duplicate content SEO penalties
https://www.drpbuildlab.com/*    https://drpbuildlab.com/:splat    301!

# Canonicalise every real page to its extensionless URL. Listed one by one
# rather than as /*.html — a wildcard also caught /404.html, which the
# catch-all below then rewrote straight back.
/index.html       /            301!
/over-ons.html    /over-ons    301!
/prijzen.html     /prijzen     301!
/contact.html     /contact     301!

# Legacy paths and old single-page anchors, now that these are real pages
/diensten     /prijzen        301
/pakketten    /prijzen        301
/pakket       /prijzen        301
/pricing      /prijzen        301
/tarifs       /prijzen        301
/precios      /prijzen        301
/faq          /prijzen#faq    301
/about        /over-ons       301
/about-us     /over-ons       301

# Catch-all 404 (must be last)
/*    /404.html    404
