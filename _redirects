# Netlify _redirects — market URLs, SEO-friendly handling
#
# Every page now lives under a market segment: /be/prijzen, /gb/prijzen,
# /jp/prijzen. A market carries both a language and a currency, so /gb/ and
# /us/ are both English at different prices. See assets/markets.js.

# Force apex (no www) — prevents duplicate content SEO penalties
https://www.drpbuildlab.com/*    https://drpbuildlab.com/:splat    301!

# ── Bare "/" goes to the visitor's market ────────────────────────────────
# 302, not 301: the destination depends on who is asking, and a permanent
# redirect would be cached and then served to the wrong country. This is the
# only place geo is still consulted — every other URL states its own market.
/                                 /be/                              302!  Country=be
/                                 /nl/                              302!  Country=nl
/                                 /fr/                              302!  Country=fr
/                                 /lu/                              302!  Country=lu
/                                 /ch/                              302!  Country=ch
/                                 /de/                              302!  Country=de
/                                 /at/                              302!  Country=at
/                                 /es/                              302!  Country=es
/                                 /gb/                              302!  Country=gb
/                                 /ie/                              302!  Country=ie
/                                 /us/                              302!  Country=us
/                                 /ca/                              302!  Country=ca
/                                 /mx/                              302!  Country=mx
/                                 /id/                              302!  Country=id
/                                 /jp/                              302!  Country=jp
/                                 /sg/                              302!  Country=sg
/                                 /au/                              302!  Country=au
/                                 /be/                              302!

# ── Pre-market URLs move into the default market ─────────────────────────
# Permanent: these are the addresses that were indexed and shared before the
# market structure existed, and they have exactly one correct destination now.
/index.html                       /be/                              301!
/over-ons                         /be/over-ons                      301!
/prijzen                          /be/prijzen                       301!
/contact                          /be/contact                       301!
/over-ons.html                    /be/over-ons                      301!
/prijzen.html                     /be/prijzen                       301!
/contact.html                     /be/contact                       301!

# Legacy paths and old single-page anchors
/diensten                         /be/prijzen                       301
/pakketten                        /be/prijzen                       301
/pakket                           /be/prijzen                       301
/pricing                          /be/prijzen                       301
/tarifs                           /be/prijzen                       301
/precios                          /be/prijzen                       301
/faq                              /be/prijzen#faq                   301
/about                            /be/over-ons                      301
/about-us                         /be/over-ons                      301

# Social card. The image was .jpg on main, became .png on this branch, then
# moved into assets/img/ — both old URLs are already out in the wild with
# anything that has scraped the page. Keep them resolving or the card breaks.
/og-image.jpg                     /assets/img/og-image.png          301
/og-image.png                     /assets/img/og-image.png          301

# Catch-all 404 (must be last)
/*                                /404.html                         404
